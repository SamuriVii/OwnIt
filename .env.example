# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ---------------------------------------------------------------------------
# Backend App
# ---------------------------------------------------------------------------
PROJECT_NAME = "OwnIt-Backend"
VERSION = "0.1.0"
ENVIRONMENT = "development"       # development | production | test

# ---------------------------------------------------------------------------
# Ports (host-side mappings in docker-compose)
# ---------------------------------------------------------------------------
BACKEND_PORT = "8000"
FRONTEND_PORT = "3000"
DB_PORT = "5432"
REDIS_PORT = "6379"

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
DB_USER = "admin"
DB_PASSWORD = "secret"
DB_NAME = "ownit_db"

DB_URL = "postgresql+psycopg2://admin:secret@database:5432/ownit_db"
TEST_DB_URL = "postgresql+psycopg2://admin:secret@database:5432/ownit_test_db"

DB_ECHO_SQL = False               # Set to True to print raw SQL queries

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_URL = "redis://redis:6379/0"
REDIS_TEST_URL = "redis://redis:6379/1"
REDIS_MAX_CONNECTIONS = 10

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
SECRET_KEY = ""                   # Required — generate with: openssl rand -hex 32

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL = "INFO"                # TRACE | DEBUG | INFO | SUCCESS | WARNING | ERROR | CRITICAL
